{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    /* The renderer runs in a Chromium (browser) environment and uses React. */
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["react", "react-dom"],
    "jsx": "react-jsx",
    "outDir": "dist/ui",
    "paths": {
      "@ui/*": ["src/ui/*"],
      "@shared/*": ["src/shared/*"],
      "@/*": ["src/ui/*"]
    }
  },
  "include": ["src/ui/**/*", "src/shared/**/*"]
}
