{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    /* The renderer runs in a Chromium (browser) environment and uses React. */
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    /* `vitest/globals` supplies the ambient test globals (describe/it/expect/vi)
       for co-located `*.test.ts(x)` files, which run with `globals: true`
       (vitest.config.ts). Renderer tests that need a DOM opt into jsdom per-file
       with a `// @vitest-environment jsdom` docblock. Test files are dev-only. */
    "types": ["react", "react-dom", "vitest/globals"],
    "jsx": "react-jsx",
    "outDir": "dist/ui",
    "paths": {
      "@ui/*": ["src/ui/*"],
      "@shared/*": ["src/shared/*"],
      "@/*": ["src/ui/*"]
    }
  },
  "include": ["src/ui/**/*", "src/shared/**/*"]
}
